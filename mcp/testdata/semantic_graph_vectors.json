      "data": {
        "catalog": "$catalog",
        "completeness": "partial",
        "cut_id": "$cut",
        "entry": {"kind": "resource", "resource": "resource:site"},
        "members": [
          {"asset_id": "asset:a", "snapshot_id": "$snapshot_a"},
          {"asset_id": "asset:b", "snapshot_id": "$snapshot_b"}
